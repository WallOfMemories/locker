# Copy to .env (local) or set these in your host's environment settings.
# They are baked into the site at BUILD time and are visible to every visitor,
# so never put secrets here (no Razorpay secret, no service-account key).

# Your deployed backend, https, no trailing slash. For local development use
# http://localhost:5000
VITE_API_BASE_URL=https://your-api.example.com

# Firebase console > Project settings > General > Your apps > Web app > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Where "Contact support" goes
VITE_SUPPORT_EMAIL=support@example.com
